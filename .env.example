# MCrypto Trading Bot - Environment Configuration
# CRITICAL: Keep this file secure and never commit to git

# ============================================
# EXCHANGE API CREDENTIALS
# ============================================

# Binance Testnet (Paper Trading - SAFE)
# Get keys from: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Binance Live (REAL MONEY - USE WITH EXTREME CAUTION)
# Get keys from: https://www.binance.com/en/my/settings/api-management
# BINANCE_API_KEY=your_live_api_key_here
# BINANCE_API_SECRET=your_live_api_secret_here

# ============================================
# TRADING MODE
# ============================================
# Set to 'testnet' for paper trading, 'live' for real money
TRADING_MODE=testnet

# ============================================
# RISK MANAGEMENT SETTINGS
# ============================================
# Maximum % of capital per single trade (default: 5%)
MAX_POSITION_PCT=0.05

# Maximum % loss allowed per day (default: 10%)
MAX_DAILY_LOSS_PCT=0.10

# Maximum % of total capital exposed at once (default: 20%)
MAX_TOTAL_EXPOSURE_PCT=0.20

# Default stop-loss % per trade (default: 2%)
STOP_LOSS_PCT=0.02

# Maximum number of trades per day
MAX_DAILY_TRADES=10

# ============================================
# ALERT NOTIFICATIONS
# ============================================
# Telegram Bot (for trade alerts)
# Get token from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./tradingbot.db

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your_secret_key_for_jwt_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# ML SERVICE & NETWORKING
# ============================================
# Backend URL for ML Service (Render example)
ML_SERVICE_URL=https://trading-bot-kea3.onrender.com

# Frontend URL (GitHub Pages example)
FRONTEND_URL=https://santicruz650.github.io

# Redis (for task queuing/caching if used)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma or JSON list if configured in config.py)
# CORS_ORIGINS=["https://santicruz650.github.io", "http://localhost:8080"]
