# MCrypto Backend Configuration
# Este es el ÚNICO archivo de entorno válido del proyecto.

# --- Binance API Keys ---
# Solo Spot Trading. Retiros DESHABILITADOS.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Operational Mode ---
ENV=production
DRY_RUN_REAL_API=True
ENABLE_REAL_TRADING=False
MOCK_EXCHANGE=True

# --- Database & Security ---
DATABASE_URL=sqlite:///./tradingbot.db
SECRET_KEY=mcrypto_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Services ---
ML_SERVICE_URL=http://localhost:8001
FRONTEND_URL=https://santicruz650.github.io
NGROK_URL=https://mcrypto-api.ngrok-free.app
MCRYPTO_MODE=PAPER_TRADING
ETAPA_2B_ENABLED=True

# --- Notifications ---
